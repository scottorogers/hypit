<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="steps" from="@example/steps-scene@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="style" source="./ai-on-site.svs"/>

  <time:Clock id="animation-clock" frame-rate="30"/>
  <time:Timeline id="animation" clock={animation-clock} end="20s"/>
  <spatial:Canvas id="canvas" width="1080" height="1920"/>
  <fonts:Stack id="font" family="inter" weight="800" style="normal"/>
  <steps:Scene id="explainer" timeline={animation.timeline} canvas={canvas} font={font}
    during="program" title="SITE TIP">
    <steps:Beat id="hook" role="hook" at="0s" text="Your install didn't slip on site. It slipped in the drawings."/>
    <steps:Beat id="one" role="step" at="3.6s" text="Check the latest revision — not the one in the van."/>
    <steps:Beat id="two" role="step" at="6.6s" text="Walk the route before the tray goes up."/>
    <steps:Beat id="three" role="step" at="9.6s" text="Flag clashes in writing, same day, with a drawing ref."/>
    <steps:Beat id="four" role="step" at="12.6s" text="Don't start a run you can't finish."/>
    <steps:Beat id="close" role="end" at="15.8s" text="Catch it on paper. Not on the ceiling."/>
  </steps:Scene>
  <film:Film id="main" canvas={canvas} timeline={animation.timeline} appearance={style.film.main}>
    <film:Track source={explainer.track}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={animation.timeline}/>
</svml>
